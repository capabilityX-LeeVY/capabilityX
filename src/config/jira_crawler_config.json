{
  "jira_crawler": {
    "default_project": "SPARK",
    "default_database": "jira_crawler_db",
    "batch_size": 100,
    "delay_between_requests": 0.1,
    "max_retries": 3,
    "timeout": 30,
    "default_issue_types": ["Bug", "Task", "Story"],
    "excluded_statuses": ["Closed", "Resolved"],
    "custom_field_mappings": {
      "customfield_11800": "team_pt",
      "customfield_10500": "epic_link",
      "customfield_10600": "story_points"
    },
    "notification": {
      "enabled": false,
      "webhook_url": "",
      "teams_room_id": ""
    },
    "schedule": {
      "enabled": false,
      "cron_expression": "0 */6 * * *",
      "days_back": 1
    }
  }
}
